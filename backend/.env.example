# Optional Redis cache connection.
# In Docker Compose, "redis" is the service name.
# For local venv runs with Redis on your machine, use redis://localhost:6379/0.
REDIS_URL=redis://localhost:6379/0

# Enable real repository analysis (cloning + scanning)
# Set to 'true' to enable. Default: false
REAL_REPO_ANALYSIS=true

# Directory where repositories will be cloned for inspection
CLONE_WORKSPACE_DIR=./tmp/repos

# Maximum repository size in MB allowed for analysis
MAX_REPO_SIZE_MB=100

# If true, cloned repos are kept on disk after analysis
KEEP_CLONED_REPOS=false

# WebSocket settings for the frontend
ENABLE_WEBSOCKET=true
BACKEND_WS_URL=ws://localhost:8000/ws/run
# Optional path to the protected security engine.
# Local venv default is ../security, Docker Compose sets this to /security.
SECURITY_ROOT=/security
